# Preferred: UT Portkey gateway. Use the existing UT pair, or set the newer
# provider slug instead of PORTKEY_VIRTUAL_KEY when your workspace migrates.
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
PORTKEY_PROVIDER=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_ENVIRONMENT=development

# Optional direct OpenAI fallback. Ignored when Portkey is fully configured.
OPENAI_API_KEY=
# Defaults match the current simulator's UT-provisioned models. Upgrade these
# only after confirming the new aliases are enabled on the Portkey route.
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_TURN_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_FEEDBACK_MODEL=gpt-4o
