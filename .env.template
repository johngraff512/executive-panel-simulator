# Portkey gateway — preferred for UT-managed API access.
# Set BOTH of these and the app routes all AI calls through the UT gateway.
# https://app.portkey.ai
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# OpenAI API key — OPTIONAL fallback only. Ignored when both Portkey vars
# above are set. Used solely for direct OpenAI access if Portkey isn't
# configured; this is a personal OpenAI-billed key, so leave it blank on UT.
OPENAI_API_KEY=

# Flask session secret — REQUIRED in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Shared access code — RECOMMENDED in production. When set, students must
# enter this code once per browser session before using the app (protects
# the OpenAI/Portkey spend from anyone who finds the URL). Leave blank to
# disable the gate (e.g. local development).
ACCESS_CODE=
